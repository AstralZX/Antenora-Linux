#!/bin/busybox sh
# Antenora disk init (initramfs for an installed system).
# Mounts the real root device (root= from the kernel cmdline), then hands off
# to s6-linux-init as PID 1. No systemd, no dracut.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /run

mkdir -p /newroot

# parse root= from the kernel command line (device or UUID=...)
ROOTDEV=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*) ROOTDEV="${arg#root=}" ;;
    esac
done

# wait for the device node / udev to settle
for i in $(seq 1 30); do
    case "$ROOTDEV" in
        UUID=*|PARTUUID=*)
            [ -e "/dev/disk/by-uuid/${ROOTDEV#UUID=}" ] && break
            ;;
        *)
            [ -e "$ROOTDEV" ] && break
            ;;
    esac
    sleep 1
done

if ! mount -o ro "$ROOTDEV" /newroot 2>/dev/null; then
    echo "Antenora: failed to mount root $ROOTDEV"
    exec /bin/sh
fi

exec switch_root /newroot /sbin/init
