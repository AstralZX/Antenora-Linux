#!/bin/busybox sh
# Antenora live init (initramfs).
# Mounts the live squashfs over a writable overlay, then hands off to
# s6-linux-init as PID 1. No systemd, no dracut.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /run

# --- load storage drivers ---------------------------------------------------
for mod in sr_mod isofs ahci libahci ata_piix sd_mod loop; do
    modprobe "$mod" 2>/dev/null
done

# --- wait for devices -------------------------------------------------------
mdev -s 2>/dev/null
sleep 2
mdev -s 2>/dev/null

mkdir -p /newroot /run/live /run/root /run/ovl/upper /run/ovl/work

# --- locate the live medium -------------------------------------------------
found=
for dev in /dev/sr0 /dev/sr1 /dev/sd* /dev/nvme* /dev/vd*; do
    [ -e "$dev" ] || continue
    if mount -o ro "$dev" /run/live 2>/dev/null; then
        if [ -f /run/live/antenora/rootfs.squashfs ]; then
            found=1
            break
        fi
        umount /run/live 2>/dev/null
    fi
done

if [ -z "$found" ]; then
    echo "Antenora: live root not found. Available block devices:"
    ls /dev/sd* /dev/sr* /dev/vd* /dev/nvme* 2>/dev/null || echo "  (none)"
    echo "Dropping to a shell."
    exec /bin/sh
fi

# --- mount the squashfs + writable overlay ----------------------------------
echo "Antenora: mounting squashfs from /run/live/antenora/rootfs.squashfs..."
mount -o ro,loop /run/live/antenora/rootfs.squashfs /run/root
echo "Antenora: squashfs mounted on /run/root"

mkdir -p /run/ovl
mount -t tmpfs -o size=50% tmpfs /run/ovl
mkdir -p /run/ovl/upper /run/ovl/work
mount -t overlay overlay \
    -o lowerdir=/run/root,upperdir=/run/ovl/upper,workdir=/run/ovl/work /newroot
echo "Antenora: overlay root ready at /newroot"

exec switch_root /newroot /bin/sh
