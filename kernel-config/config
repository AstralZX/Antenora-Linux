# Antenora Linux kernel configuration
# linux-cachyos-bore — the Ninth Circle scheduler.
# This is the baseline that `make olddefconfig` expands into a full config.
# Key tenets: 1000Hz, preempt=full (dynamic), BORE scheduler, -O3 -march=native.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT_RCU=y

# 1000 Hz — the only acceptable tick rate
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING=y

# BORE scheduler (Burst-Oriented Response Enhancer)
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y

# Full tickless + RCU nocb
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y

# Optimize hard
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_FLAGS="-O3 -march=native -pipe"

# Filesystems — XFS first-class
CONFIG_XFS_FS=y
CONFIG_XFS_SUPPORT_V4=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_RT=y
CONFIG_EXT4_FS=m
CONFIG_BTRFS_FS=m

# ZRAM / zswap
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# Netfilter
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_FIB_INET=y
CONFIG_NF_CONNTRACK=y

# Hardware support
CONFIG_PCI=y
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_NOUVEAU=m
CONFIG_FB_EFI=y

# UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_FB_SIMPLE=y

# Initramfs
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_BLK_DEV_INITRD=y

# Firmware
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE=""

# Timers / latency
CONFIG_HZ_PERIODIC=n
CONFIG_TICK_CPU_ACCOUNTING=y
CONFIG_IRQ_TIME_ACCOUNTING=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_XZ=y
