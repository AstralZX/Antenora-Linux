# Antenora neofetch configuration — the crest and a line from the Inferno.

print_info() {
    info title
    info underline

    info "OS" distro
    info "Host" model
    info "Kernel" kernel
    info "Uptime" uptime
    info "Packages" packages
    info "Shell" shell
    info "Resolution" resolution
    info "DE" de
    info "WM" wm
    info "CPU" cpu
    info "GPU" gpu
    info "Memory" memory
    info "Quote" get_quote

    info cols
}

get_quote() {
    quotes_file="/usr/share/antenora/quotes.txt"
    if [ -f "$quotes_file" ]; then
        shuf -n1 "$quotes_file"
    else
        echo "Abandon all hope, ye who enter here."
    fi
}

title_fqdn="off"
kernel_shorthand="on"
os_arch="on"
uptime_shorthand="on"
memory_percent="off"
underline_enabled="on"
underline_char="─"
separator=" — "

ascii_distro="antenora"

ANTENORA_LOGO=$(cat <<'EOF'
${c1}                          \  |  /
${c1}                        -  ANTENORA  -
${c1}                        /  |  \  |  /
${c1}              ${c2}_,-,_
${c1}            ${c2}.-'     '-.
${c1}           ${c2}/  _   _   \
${c1}          ${c2}|  (o) (o)   |
${c1}          ${c2}|     ^      |
${c1}           ${c2}\    '-'   /
${c1}            ${c2}'-._   _.-'
${c1}                ${c2}'-'
EOF
)

# Hook the logo into the ascii output.
get_distro_cols() { :; }
