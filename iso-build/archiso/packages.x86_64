# Base packages for the Antenora live environment.
# The live ISO is a bootstrap only: it boots the stock `linux` kernel so the
# image builds against vanilla Arch repos. The Gates of Hell installer then
# replaces it with linux-cachyos-bore via Dante on the installed system.

base
base-devel
linux
linux-firmware
intel-ucode
amd-ucode
grub
efibootmgr
os-prober
s6
s6-rc
s6-linux-init
skalibs
execline
busybox
bash
zsh
git
wget
curl
xfsprogs
dosfstools
btrfs-progs
util-linux
e2fsprogs
lvm2
cryptsetup
zram-generator
lz4
zstd
nftables
iptables
iproute2
networkmanager
dhclient
dialog
arch-install-scripts
dracut
mkinitcpio
neofetch
openssh
sudo
coreutils
gnupg
