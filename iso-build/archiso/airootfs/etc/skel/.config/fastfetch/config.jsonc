{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": "/usr/share/antenora/fastfetch/antenora-logo.txt",
        "padding": {
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " : ",
        "key": {
            "width": 14
        },
        "color": {
            "keys": "red",
            "separator": "red"
        }
    },
    "modules": [
        {
            "type": "title"
        },
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "command",
            "key": "Quote",
            "text": "shuf -n1 /usr/share/antenora/quotes.txt"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2
        }
    ]
}
