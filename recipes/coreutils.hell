package "coreutils" version "9.5" {
    description "GNU core utilities"
    source "https://ftp.gnu.org/gnu/coreutils/coreutils-9.5.tar.xz"
    depends "openssl"

    build {
        run "./configure --prefix=/usr ac_cv_func_memset_explicit=no"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
