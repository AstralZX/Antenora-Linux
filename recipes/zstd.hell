package "zstd" version "1.5.6" {
    description "Zstandard compression library and tools"
    source "https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz"

    build {
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT PREFIX=/usr"
    }
}
