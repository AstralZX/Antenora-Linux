package "zsh" version "5.9" {
    description "Z shell - the Antenora default shell"
    source "https://downloads.sourceforge.net/project/zsh/zsh/5.9/zsh-5.9.tar.xz"
    depends "ncurses" "pcre2"

    binary "https://raw.githubusercontent.com/AstralZX/antenora-packages/main/packages/zsh/zsh-5.9-x86_64.tar.xz" {
        sha256 "eb0427f38f294c4709f04315e295dc64b5c758ff05798ca1dbe67ab6a35af69f"
        size "2.1MB"
    }

    arch x86_64 {
        cflags "-march=native -O3 -pipe -Wno-error=incompatible-pointer-types"
    }

    build {
        run "./configure --prefix=/usr --enable-multibyte"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

}
