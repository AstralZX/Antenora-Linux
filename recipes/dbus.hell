package "dbus" version "1.14.10" {
    description "D-Bus message bus (systemd-free)"
    source "https://dbus.freedesktop.org/releases/dbus/dbus-1.14.10.tar.xz"

    build {
        run "./configure --prefix=/usr --sysconfdir=/etc --without-systemd"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
