package "libunistring" version "1.3" {
    description "libunistring - Unicode string library"
    source "https://ftp.gnu.org/gnu/libunistring/libunistring-1.3.tar.xz"

    arch x86_64 {
        cflags "-O2"
    }

    build {
        run "./configure --prefix=/usr --disable-doc"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

}
