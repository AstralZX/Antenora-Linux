package "glibc" version "2.39" {
    description "The GNU C library - the Antenora libc"
    source "https://ftp.gnu.org/gnu/glibc/glibc-2.39.tar.xz"
    depends "linux-api-headers"

    arch x86_64 {
        cflags "-march=native -O3 -pipe -fno-plt"
    }

    arch aarch64 {
        cflags "-mcpu=native -O3 -pipe"
    }

    build {
        mkdir "$HELL_SRC_DIR/build"
        run "cd build && ../configure --prefix=/usr --disable-nscd --enable-stack-protector=strong --disable-werror"
        run "cd build && make -j$HELL_JOBS"
    }

    install {
        run "cd build && make install DESTDIR=$HELL_ROOT"
    }

    post_install {
        run "ldconfig -r $HELL_ROOT || true"
    }

}
