package "sudo" version "1.9.15p5" {
    description "Privilege escalation for the wheel"
    source "https://www.sudo.ws/dist/sudo-1.9.15p5.tar.gz"

    cflags "-O2 -Wno-error=incompatible-pointer-types"

    build {
        run "./configure --prefix=/usr --with-env-editor --with-passprompt=[Antenora]"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install INSTALL_OWNER= DESTDIR=$HELL_ROOT"
    }

    post_install {
        run "mkdir -p $HELL_ROOT/etc/sudoers.d && echo '%wheel ALL=(ALL:ALL) ALL' > $HELL_ROOT/etc/sudoers.d/10-wheel"
    }

}
