package "sudo" version "1.9.15p5" {
    description "Privilege escalation for the wheel"
    source "https://www.sudo.ws/dist/sudo-1.9.15p5.tar.gz"

    build {
        run "./configure --prefix=/usr --with-env-editor --with-passprompt=[Antenora]"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

    post_install {
        run "echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel"
    }

    binary "https://cdn.antenora.org/packages/sudo-1.9.15p5-x86_64.db" {
        sha256 "a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1"
        size "4.2MB"
    }
}
