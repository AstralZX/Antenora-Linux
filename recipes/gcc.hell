package "gcc" version "15.2.0" {
    description "The GNU Compiler Collection"
    source "https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
    depends "gmp" "mpfr" "mpc" "isl" "linux-api-headers"

    arch x86_64 {
        cflags "-march=native -O3 -pipe -std=gnu17"
    }

    build {
        run "sed -i 's/__cplusplus != 201103/__cplusplus < 201103/g' libcody/configure libcody/config.m4"
        run "sed -i 's/u8\"/\"/g' libcody/buffer.cc libcody/client.cc libcody/cody.hh libcody/server.cc"
        mkdir "$HELL_SRC_DIR/build"
        run "cd build && ../configure --prefix=/usr --enable-languages=c,c++ --disable-multilib --disable-bootstrap --enable-checking=release --enable-lto --enable-linker-build-id --disable-libsanitizer --disable-libquadmath"
        run "cd build && make -j$HELL_JOBS"
    }

    install {
        run "cd build && make install DESTDIR=$HELL_ROOT"
    }

    post_install {
        ln "gcc" "/usr/bin/cc"
    }
}
