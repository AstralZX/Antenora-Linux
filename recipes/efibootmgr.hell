package "efibootmgr" version "18" {
    description "Tool to manage UEFI boot entries"
    source "https://github.com/rhboot/efibootmgr/archive/refs/tags/18.tar.gz"
    depends "efivar"

    build {
        run "make EFIDIR=antenora ERRORS= -j$HELL_JOBS"
    }

    install {
        run "make EFIDIR=antenora install DESTDIR=$HELL_ROOT"
    }
}
