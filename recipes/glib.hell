package "glib" version "2.80.5" {
    description "GLib - low-level core library"
    source "https://download.gnome.org/sources/glib/2.80/glib-2.80.5.tar.xz"
    depends "libffi" "pcre2" "zlib"

    arch x86_64 {
        cflags "-O2"
    }

    build {
        run "meson setup build --prefix=/usr -Dc_std=gnu11 -Dlibmount=disabled -Dselinux=disabled -Dintrospection=disabled -Dgtk_doc=false -Dman=false -Dtests=false -Dinstalled_tests=false -Db_lundef=false"
        run "sed -i -e '/^#define HAVE_FREE_SIZED 1$/d' -e '/^#define HAVE_FREE_ALIGNED_SIZED 1$/d' build/config.h"
        run "ninja -C build -j$HELL_JOBS"
    }

    install {
        run "DESTDIR=$HELL_ROOT ninja -C build install"
    }

}
