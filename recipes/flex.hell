package "flex" version "2.6.4" {
    description "Flex - the fast lexical analyzer generator"
    source "https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz"
    depends "m4"

    build {
        run "./configure --prefix=/usr"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
