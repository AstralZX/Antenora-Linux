package "s6-linux-init" version "1.1.2.1" {
    description "s6-linux-init - PID 1 and early boot for Linux"
    source "https://skarnet.org/software/s6-linux-init/s6-linux-init-1.1.2.1.tar.gz"
    depends "s6" "execline" "skalibs"

    build {
        run "./configure --prefix=/usr --enable-shared --with-sysdeps=$HELL_SYSROOT/usr/lib/skalibs/sysdeps --with-include=$HELL_SYSROOT/usr/include --with-lib=$HELL_SYSROOT/usr/lib"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
