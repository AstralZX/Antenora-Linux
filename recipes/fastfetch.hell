package "fastfetch" version "2.20.0" {
    description "fastfetch - a blazing-fast neofetch replacement"
    source "https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.20.0.tar.gz"

    build {
        run "cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr"
        run "cmake --build build -j$HELL_JOBS"
    }

    install {
        run "cmake --install build --prefix $HELL_ROOT/usr"
    }
}
