package "s6" version "2.12.0.4" {
    description "s6 and s6-rc - the Antenora init system"
    source "https://skarnet.org/software/s6/s6-2.12.0.4.tar.gz"
    depends "skalibs" "execline"

    arch x86_64 {
        cflags "-march=native -O3 -pipe"
    }

    build {
        run "./configure --prefix=/usr --with-sysdeps=/usr/lib/skalibs/sysdeps"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
        mkdir "/etc/s6-rc"
        mkdir "/run/service"
    }

    post_install {
        run "s6-rc-compile /etc/s6-rc/compiled /etc/s6-rc/source"
    }

    binary "https://cdn.antenora.org/packages/s6-2.12.0.4-x86_64.db" {
        sha256 "f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8d7c6b5a4"
        size "2.1MB"
    }
}
