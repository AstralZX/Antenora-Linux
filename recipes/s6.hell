package "s6" version "2.12.0.4" {
    description "s6 and s6-rc - the Antenora init system"
    source "https://skarnet.org/software/s6/s6-2.12.0.4.tar.gz"
    depends "skalibs" "execline"

    arch x86_64 {
        cflags "-march=native -O3 -pipe"
    }

    build {
        run "./configure --prefix=/usr --enable-shared --with-sysdeps=$HELL_SYSROOT/usr/lib/skalibs/sysdeps --with-include=$HELL_SYSROOT/usr/include --with-lib=$HELL_SYSROOT/usr/lib"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
        mkdir "/etc/s6-rc"
        mkdir "/run/service"
    }

}
