package "sway" version "1.9" {
    description "SwayWM - the rice-ready Wayland compositor"
    source "https://github.com/swaywm/sway/archive/refs/tags/1.9.tar.gz"
    depends "greetd" "wlroots" "waybar" "pipewire"

    build {
        run "meson setup build --prefix=/usr"
        run "ninja -C build -j$HELL_JOBS"
    }

    install {
        run "DESTDIR=$HELL_ROOT ninja -C build install"
        mkdir "/etc/s6-rc/source/greetd"
    }

    post_install {
        run "s6-rc -u change greetd"
    }

}
