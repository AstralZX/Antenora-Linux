package "neofetch" version "7.1.0" {
    description "System info fetcher with the Antenora crest"
    source "https://github.com/dylanaraps/neofetch/archive/refs/tags/7.1.0.tar.gz"

    build {
        run "true"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT PREFIX=/usr"
    }

    post_install {
        cp "/usr/share/antenora/neofetch/antenora" "/etc/neofetch/config.conf"
    }

    binary "https://cdn.antenora.org/packages/neofetch-7.1.0-x86_64.db" {
        sha256 "d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6"
        size "320KB"
    }
}
