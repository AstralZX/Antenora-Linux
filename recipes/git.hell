package "git" version "2.45.2" {
    description "Git - the distributed version control system"
    source "https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.45.2.tar.xz"
    depends "curl" "openssl" "zlib" "pcre2"

    build {
        run "make prefix=/usr -j$HELL_JOBS"
    }

    install {
        run "make prefix=/usr install DESTDIR=$HELL_ROOT"
    }
}
