package "gmp" version "6.3.0" {
    description "GNU Multiple Precision arithmetic library"
    source "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz"

    build {
        run "./configure --prefix=/usr --enable-cxx"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
