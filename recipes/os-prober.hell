package "os-prober" version "1.81" {
    description "Detect other operating systems for GRUB"
    source "https://salsa.debian.org/installer-team/os-prober/-/archive/1.81/os-prober-1.81.tar.gz"

    build {
        run "make -j$HELL_JOBS"
    }

    install {
        mkdir "/usr/lib/os-prober"
        run "install -Dm755 os-prober $HELL_ROOT/usr/lib/os-prober/os-prober"
        run "install -Dm755 linux-boot-prober $HELL_ROOT/usr/lib/os-prober/linux-boot-prober"
        run "install -Dm755 newns $HELL_ROOT/usr/lib/os-prober/newns"
        run "install -Dm755 common.sh $HELL_ROOT/usr/lib/os-prober/common.sh"
        run "cp -a os-probes $HELL_ROOT/usr/lib/os-prober/os-probes"
        run "cp -a linux-boot-probes $HELL_ROOT/usr/lib/os-prober/linux-boot-probes"
        ln "../lib/os-prober/os-prober" "/usr/bin/os-prober"
        ln "../lib/os-prober/linux-boot-prober" "/usr/bin/linux-boot-prober"
    }
}
