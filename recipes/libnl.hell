package "libnl" version "3.9.0" {
    description "Netlink protocol library suite"
    source "https://github.com/thom311/libnl/releases/download/libnl3_9_0/libnl-3.9.0.tar.gz"

    build {
        run "./configure --prefix=/usr"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
