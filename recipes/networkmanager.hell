package "networkmanager" version "1.48.2" {
    description "NetworkManager with s6 integration"
    source "https://download.gnome.org/sources/NetworkManager/1.48/NetworkManager-1.48.2.tar.xz"
    depends "libnl" "dbus" "elogind" "glib"

    build {
        run "meson setup build --prefix=/usr -Dmodem_manager=false -Dselinux=false -Dintrospection=false -Dcrypto=gnutls -Dsystemdsystemunitdir=no -Dsystemd_journal=false -Dsession_tracking=elogind -Dsuspend_resume=elogind -Dlibaudit=no -Dpolkit=false -Dovs=false -Dlibpsl=false -Dconcheck=false -Dnmtui=false -Dnm_cloud_setup=false -Dppp=false"
        run "ninja -C build -j$HELL_JOBS"
    }

    install {
        run "DESTDIR=$HELL_ROOT ninja -C build install"
        run "mkdir -p $HELL_ROOT/etc/s6-rc/source/NetworkManager && cp $HELL_ROOT/usr/share/antenora/s6/NetworkManager/run $HELL_ROOT/etc/s6-rc/source/NetworkManager/run 2>/dev/null || true"
    }


}
