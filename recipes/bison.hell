package "bison" version "3.8.2" {
    description "Bison - the parser generator"
    source "https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"
    depends "m4"

    build {
        run "./configure --prefix=/usr"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
