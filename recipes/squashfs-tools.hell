package "squashfs-tools" version "4.6.1" {
    description "Squashfs userspace tools (mksquashfs, unsquashfs)"
    source "https://github.com/plougher/squashfs-tools/archive/refs/tags/4.6.1.tar.gz"
    depends "zstd" "lz4" "xz"

    build {
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install INSTALL_DIR=$HELL_ROOT/usr/bin"
    }
}
