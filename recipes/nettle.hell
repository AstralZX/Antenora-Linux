package "nettle" version "3.10.1" {
    description "Nettle - low-level cryptographic library"
    source "https://ftp.gnu.org/gnu/nettle/nettle-3.10.1.tar.gz"
    depends "gmp"

    arch x86_64 {
        cflags "-O2"
    }

    build {
        run "./configure --prefix=/usr --disable-doc --disable-tests"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

}
