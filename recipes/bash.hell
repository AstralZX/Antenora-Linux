package "bash" version "5.2.32" {
    description "GNU Bourne Again Shell"
    source "https://ftp.gnu.org/gnu/bash/bash-5.2.32.tar.gz"
    depends "ncurses" "readline"

    build {
        run "CFLAGS=\"-std=gnu17 -O2\" ./configure --prefix=/usr --with-installed-readline"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

    post_install {
        ln "bash" "/usr/bin/sh"
    }
}
