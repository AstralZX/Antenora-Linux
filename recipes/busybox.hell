package "busybox" version "1.36.1" {
    description "BusyBox - the Swiss army knife of embedded Linux (static)"
    source "https://busybox.net/downloads/busybox-1.36.1.tar.bz2"

    build {
        run "make defconfig"
        run "echo 'CONFIG_STATIC=y' >> .config"
        run "echo 'CONFIG_ASH=y' >> .config"
        run "echo 'CONFIG_SWITCH_ROOT=y' >> .config"
        run "echo 'CONFIG_MOUNT=y' >> .config"
        run "echo 'CONFIG_UMOUNT=y' >> .config"
        run "sed -i 's/CONFIG_TC=y/# CONFIG_TC is not set/' .config"
        run "sed -i 's/CONFIG_IPROUTE=y/# CONFIG_IPROUTE is not set/' .config"
        run "yes '' | make oldconfig"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make CONFIG_PREFIX=$HELL_ROOT install"
    }
}
