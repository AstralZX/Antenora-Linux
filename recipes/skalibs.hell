package "skalibs" version "2.14.1.1" {
    description "Skalibs - general-purpose libraries for s6"
    source "https://skarnet.org/software/skalibs/skalibs-2.14.1.1.tar.gz"

    build {
        run "./configure --prefix=/usr --enable-static-libc"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
