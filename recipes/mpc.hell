package "mpc" version "1.3.1" {
    description "Multiple Precision Complex library"
    source "https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
    depends "mpfr"

    cflags "-O2 -std=gnu17 -pipe"

    build {
        run "./configure --prefix=/usr"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
