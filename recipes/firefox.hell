package "firefox" version "127.0" {
    description "Firefox - the free and open web browser"
    source "https://archive.mozilla.org/pub/firefox/releases/127.0/source/firefox-127.0.source.tar.xz"
    depends "gtk3" "libvpx" "ffmpeg"

    build {
        run "./mach build"
    }

    install {
        run "./mach install --prefix $HELL_ROOT/usr"
    }

}
