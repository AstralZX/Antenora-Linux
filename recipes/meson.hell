package "meson" version "1.4.1" {
    description "Meson - the build system for humans"
    source "https://github.com/mesonbuild/meson/releases/download/1.4.1/meson-1.4.1.tar.gz"
    depends "python" "ninja"

    build {
        run "true"
    }

    install {
        run "install -Dm755 meson.py $HELL_ROOT/usr/bin/meson"
        run "mkdir -p $HELL_ROOT/usr/lib/python3.12/site-packages && cp -a mesonbuild $HELL_ROOT/usr/lib/python3.12/site-packages/"
    }
}
