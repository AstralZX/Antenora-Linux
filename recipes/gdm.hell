package "gdm" version "46.2" {
    description "GDM - GNOME Display Manager"
    source "https://download.gnome.org/sources/gdm/46/gdm-46.2.tar.xz"
    depends "gnome-shell" "elogind"

    build {
        run "meson setup build --prefix=/usr -Dsystemd=false"
        run "ninja -C build -j$HELL_JOBS"
    }

    install {
        run "DESTDIR=$HELL_ROOT ninja -C build install"
    }
}
