package "grub" version "2.12" {
    description "GRUB 2 - the Antenora gatekeeper"
    source "https://ftp.gnu.org/gnu/grub/grub-2.12.tar.xz"
    depends "efibootmgr" "os-prober"

    build {
        run "./configure --prefix=/usr --with-platform=efi --target=x86_64 --disable-werror"
        run "touch grub-core/extra_deps.lst"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }

}
