package "jq" version "1.7.1" {
    description "jq - a lightweight JSON processor"
    source "https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-1.7.1.tar.gz"

    build {
        run "./configure --prefix=/usr"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
