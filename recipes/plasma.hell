package "plasma" version "6.1.0" {
    description "KDE Plasma desktop (full) with SDDM"
    source "https://download.kde.org/stable/plasma/6.1.0/plasma-desktop-6.1.0.tar.xz"
    depends "sddm" "kwin" "dolphin" "konsole" "networkmanager"

    build {
        run "cmake -B build -DCMAKE_INSTALL_PREFIX=/usr"
        run "cmake --build build -j$HELL_JOBS"
    }

    install {
        run "cmake --install build --prefix $HELL_ROOT/usr"
        mkdir "/etc/s6-rc/source/sddm"
    }

    post_install {
        run "s6-rc -u change sddm"
    }

    binary "https://cdn.antenora.org/packages/plasma-6.1.0-x86_64.db" {
        sha256 "7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8d"
        size "1.1GB"
    }
}
