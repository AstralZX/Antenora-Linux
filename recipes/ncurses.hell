package "ncurses" version "6.5" {
    description "Ncurses terminal UI library"
    source "https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz"

    build {
        run "./configure --prefix=/usr --with-shared --without-debug --enable-widec --without-cxx"
        run "make -j$HELL_JOBS"
    }

    install {
        run "make install DESTDIR=$HELL_ROOT"
    }
}
